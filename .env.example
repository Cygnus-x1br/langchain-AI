# ========================================================
# Configurações de Rede e Endpoints dos Serviços
# ========================================================
# Endereço do servidor Ollama (ex: http://localhost:11434 ou IP da rede local)
OLLAMA_BASE_URL=http://localhost:11434

# Endereço do proxy LiteLLM ou 9Router (ex: http://localhost:4000/v1)
LITELLM_BASE_URL=http://localhost:4000/v1

# ========================================================
# Chaves de Autenticação das APIs
# ========================================================
# Chave Master ou Virtual Key do seu LiteLLM Proxy
LITELLM_API_KEY=sk-your-litellm-api-key-here

# Chave da API de busca do Tavily (https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Chave da API OpenWeatherMap (https://openweathermap.org)
OPENWEATHERMAP_API_KEY=your-openweather-api-key-here

# ========================================================
# Configurações do Orquestrador
# ========================================================
LOGS_DIR=/app/logs
DOCUMENTS_DIR=/app/documents
PORT=8000

# ========================================================
# Configurações do RAG (Qdrant & Embeddings)
# ========================================================
# URL do banco de vetores Qdrant (dentro do docker-compose: http://qdrant:6333)
QDRANT_URL=http://localhost:6333

# Nome da coleção padrão de documentos no Qdrant
RAG_COLLECTION_NAME=knowledge_base

# Modelo de embeddings no Ollama (ex: nomic-embed-text ou bge-m3)
EMBEDDING_MODEL=nomic-embed-text

# Senha de proteção para ações e edição na aba de Administração do Dashboard
DASHBOARD_ADMIN_PASSWORD=admin
